# Referência das variáveis (sem valores). NÃO coloque segredos em arquivos .env nesta pasta:
# em produção eles vão para a Cloudflare com `npx wrangler secret put <NOME>` (ver README, "Deploy").

# --- Build (entra no JS do navegador; passe no comando do deploy) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Segredos do Worker (wrangler secret put) ---
# Chave do OpenRouter (grátis em openrouter.ai; dá acesso a vários LLMs)
OPENROUTER_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
# Gere com: openssl rand -base64 32
AGENT_SESSION_SECRET=
RESEND_API_KEY=
LEAD_TO_EMAIL=
# onboarding@resend.dev até verificar o domínio no Resend
LEAD_FROM_EMAIL=
# Termos proibidos separados por vírgula (os mesmos do secret do GitHub; CI e filtro de saída do agente)
CONTENT_DENYLIST=

# --- Não secretas (já definidas em `vars` no wrangler.jsonc) ---
AGENT_MODEL=openrouter:google/gemma-4-31b-it:free
# Reservas do OpenRouter, separadas por vírgula (ausente = padrão do código; vazio = nenhuma)
# AGENT_FALLBACK_MODELS=
CLIENT_IP_HEADER=cf-connecting-ip

# --- Opcionais (padrões no código) ---
# AGENT_DAILY_TOKEN_CAP=1500000
# LEAD_DAILY_CAP=30

# --- Só testes locais/CI. Nunca em produção ---
# AGENT_ALLOW_MOCK=1
